rules_version = '2';

// Sicherheitsregeln für Toms Hütte.
// Nur das Admin-Konto "silkeadmin" darf schreiben. Die Selbstregistrierung ist in Firebase abgeschaltet.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'silkeadmin@toms-huette-borkum.firebaseapp.com';
    }

    // Öffentlich lesbar: Preise, Belegung (nur Datumsangaben) und Bilder
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bookings/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['from', 'to'])
        && request.resource.data.from is string
        && request.resource.data.to is string;
      allow delete: if isAdmin();
    }
    match /images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Privat: Notizen zu Buchungen sieht nur der Admin
    match /bookingNotes/{id} {
      allow read, write: if isAdmin();
    }
  }
}
